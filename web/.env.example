# Postgres (Neon) — pooled connection string.
# OPTIONAL in dev/tests: leave unset and the app falls back to a local,
# file-backed PGlite database at web/.pglite. Run `npm run db:migrate:dev`
# once to create/migrate it, then `npm run dev` — zero external setup.
# Required in production (NODE_ENV=production has no PGlite fallback).
DATABASE_URL=

# Login password for the single owner
ADMIN_PASSWORD=

# 32+ random chars for iron-session cookie encryption (openssl rand -base64 32)
SESSION_SECRET=

# Bearer token external feeders use on POST /api/ideas (openssl rand -hex 24)
CAPTURE_TOKEN=

# Bearer token the local agent uses on /api/agent/* (openssl rand -hex 24)
AGENT_TOKEN=

# Bearer token Vercel Cron sends to authenticate the daily scout run
# (openssl rand -hex 24). Vercel sets Authorization: Bearer $CRON_SECRET
# automatically for cron requests when this env var exists.
CRON_SECRET=

# TypeSafe AI API key (see https://docs.typesafe.ai/) — powers Jev via the
# jev-judge library. OPTIONAL: ranks what a search finds and filters spam
# (without it, Search saves what the free sources find, unranked — see
# lib/scout-run.ts), and scores how human a draft reads.
TYPESAFE_API_KEY=

# Bluesky login used to search posts (lib/sources/bluesky.ts). OPTIONAL:
# without both of these, Bluesky search is skipped (returns no candidates —
# Hacker News still runs) and a one-time warning is logged; the app never
# fails because of it. Bluesky's unauthenticated search endpoint returns 403
# ("Request forbidden by administrative rules"), so authenticated search is
# the only way this source works.
# BLUESKY_IDENTIFIER: your handle or email, e.g. you.bsky.social
BLUESKY_IDENTIFIER=
# BLUESKY_APP_PASSWORD: an App Password from bsky.app → Settings → Privacy
# and security → App passwords. Use an App Password here, NEVER your actual
# account password — an App Password can be revoked on its own without
# changing your login.
BLUESKY_APP_PASSWORD=

# Additional discovery sources (lib/sources/, see docs/sources.md) — every
# var below is OPTIONAL: without it, that one source reports "disabled" and
# is skipped (search-box.tsx's "off: …" hint), the rest of the scout still
# runs. arXiv/dev.to/Lobsters need no env at all and aren't listed here.

# GitHub repo search — unauthenticated works fine (60 req/h); set this to raise it to 5,000/h.
GITHUB_TOKEN=
# Mastodon hashtag search — which public instances to search, comma-separated
# hosts (no scheme, no path). Defaults to
# mastodon.social,fosstodon.org,hachyderm.io,indieweb.social. Every listed
# instance is queried for the first two usable hashtags of the query, in
# parallel, and the results merged — a hashtag timeline is federated, but
# which posts an instance has actually seen depends on who its members
# follow, so more instances means genuinely more candidates.
MASTODON_INSTANCES=
# MASTODON_INSTANCE (singular) — the original one-instance var, STILL
# SUPPORTED: set it to pin Mastodon search to exactly that host and it wins
# over MASTODON_INSTANCES above.
MASTODON_INSTANCE=
# Lemmy post search — which public instances to query, comma-separated hosts
# (e.g. lemmy.ml,lemmy.world). Defaults to
# lemmy.world,lemmy.ml,sh.itjust.works,programming.dev. Each instance is
# queried on both sorts (TopAll and TopMonth) in parallel and the results
# merged; an instance only searches the communities it has federated, so the
# lists genuinely differ.
LEMMY_INSTANCES=
# LEMMY_INSTANCE (singular) — the original one-instance var, STILL SUPPORTED:
# set it to pin Lemmy search to exactly that host and it wins over
# LEMMY_INSTANCES above.
LEMMY_INSTANCE=
# YouTube Data API v3 search — required for this source to run. Free key from console.cloud.google.com.
YOUTUBE_API_KEY=
# Reddit OAuth "application-only" search — required (with the secret below).
# NOTE (2026-09): Reddit's Data API is "legacy" and new app registrations are
# granted only for moderation use cases (see reddit.com/wiki/api); the
# prefs/apps form silently refuses other accounts. This source therefore
# stays off unless you already hold Data API credentials from an older app.
REDDIT_CLIENT_ID=
# Reddit OAuth client secret, paired with REDDIT_CLIENT_ID above.
REDDIT_CLIENT_SECRET=
# Reddit search's required User-Agent identifier — not a credential. Defaults to "postecho".
REDDIT_USERNAME=
# Product Hunt v2 GraphQL API token — required for this source to run. Free from producthunt.com/v2/oauth/applications.
PRODUCTHUNT_TOKEN=

# --- M3 publishing (spec §6.3, docs/plans/2026-09-22-m3-publishing.md) ---
# Every var below is OPTIONAL in dev: each integration degrades with a visible
# status and the flow can still be driven by hand.

# Upstash QStash — the timer that calls POST /api/publish/[id] a few minutes
# (Settings → leadTimeMinutes) before a scheduled slot, Mac off (lib/qstash.ts).
# Without QSTASH_TOKEN the timer is off: a scheduled post keeps qstash_message_id
# null and waits for POST /api/scheduled-posts/[id]/run (or Plan's Run/Resend).
# Tokens are REGIONAL: set QSTASH_URL to the endpoint the Upstash console shows
# next to the token (the owner's is https://qstash-eu-central-1.upstash.io) —
# it is passed as the SDK's baseUrl; the global endpoint rejects a regional token.
QSTASH_URL=
QSTASH_TOKEN=
# Signing keys (Upstash console → QStash → Signing keys), BOTH required: the
# webhook accepts only a delivery it can verify with one of them (or an owner
# session). Keeping both means a key rotation never locks the webhook out.
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Resend — sends the due-post email with its "Post on X" / "Post on LinkedIn"
# buttons (lib/email.ts). Without it the email is written to the server log
# instead and the row still becomes `emailed`, so the flow runs end to end in dev.
RESEND_API_KEY=
# Sender, "Name <address>". OPTIONAL: defaults to "PostEcho <onboarding@resend.dev>",
# Resend's shared test sender, which only delivers to the Resend account owner's
# OWN address — set Settings → notificationEmail to that address. Sending from
# anything else needs a domain verified in Resend.
RESEND_FROM=

# The public origin of this deployment (no trailing slash): where QStash
# delivers the webhook and the base of the email's "Mark as posted" links.
# Defaults to http://localhost:3210 in dev — QStash can't reach that, so dev
# uses the /run route; set it to the Vercel URL in production.
PUBLIC_BASE_URL=
