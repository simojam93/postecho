# postecho-agent configuration.
# Copy to .env (already git-ignored) and fill in AGENT_TOKEN from web/.env.local.

# Base URL of the postecho-web deployment this agent polls for jobs.
POSTECHO_URL=http://localhost:3000

# Bearer token shared with postecho-web's AGENT_TOKEN env var. Required.
AGENT_TOKEN=

# Claude Code CLI binary used for headless generation (owner's subscription — no API key).
CLAUDE_BIN=claude

# Model alias passed to `claude -p --model`.
CLAUDE_MODEL=sonnet

# The port on 127.0.0.1 where the PostEcho page wakes the agent. The agent sends nothing
# until the page asks, so it makes no requests while PostEcho is closed. 0 turns this off
# and the agent asks for jobs on its own, with the two settings below.
AGENT_WAKE_PORT=47321

# How long (minutes) the agent stays awake after the page's last request.
AGENT_AWAKE_MINUTES=10

# How often (minutes) the asleep agent asks for jobs anyway, for jobs made from another
# device. 0 means never.
AGENT_IDLE_CHECK_MINUTES=0

# Polling only (AGENT_WAKE_PORT=0): how long (seconds, 0-25) each GET /api/agent/jobs request waits for a job. 0 asks
# and returns at once: on Vercel a waiting request is billed for every second.
POLL_WAIT_SECONDS=0

# Polling only: the pause (seconds) after a claim that found nothing, before asking again.
POLL_IDLE_SECONDS=5

# Kill + fail a `claude -p` invocation that runs longer than this (ms). Opus
# gets twice this, and a whole-video read twice again; a job never runs past
# 9 minutes, since the web app puts one back in the queue after 10.
CLAUDE_TIMEOUT_MS=180000

# Optional but recommended for the launchd daemon: a long-lived Claude Code
# OAuth token from `claude setup-token` (requires a Claude subscription).
# The spawned `claude -p` child inherits it, so the agent keeps working even
# when the interactive CLI session's token has expired. Never commit .env.
# CLAUDE_CODE_OAUTH_TOKEN=
